# Copy to web/.env.local and fill in real values. .env* is gitignored; this file
# documents what the app needs. Never put real keys in here.

# Supabase project (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Safe to expose to the browser: access is limited by row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SECRET. Server-only (never prefix with NEXT_PUBLIC_). Bypasses RLS; used by the
# student join / progress API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Password for the seeded CIC admin (demo.admin@example.com) when you run
# `npm run seed:demo`. If unset, a random one is generated and printed once.
# DEMO_ADMIN_PASSWORD=choose-a-strong-password

# Secret key CIC's own org dashboard sends to read cohort completion and learning
# gain (GET /api/v1/cohorts, see docs/API.md). Make it long and random, at least 24
# characters, e.g.:  openssl rand -hex 24
# Without it the endpoint refuses every request (503). Server-only, never NEXT_PUBLIC_.
CIC_DASHBOARD_API_KEY=your-long-random-key

# Teacher class assistant (/teach/assistant). Anthropic-compatible gateway, e.g. the
# OHack AI gateway. SECRET, server-only: never prefix with NEXT_PUBLIC_. Without these
# the assistant page shows "not set up" and the API refuses (503).
AI_GATEWAY_URL=https://ai.ohack.dev
AI_GATEWAY_KEY=your-gateway-key
AI_MODEL=muse-wonder
